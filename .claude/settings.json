{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go env:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go tool cover:*)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make tidy)",
      "Bash(make coverage-check)",
      "Bash(make mutation)",
      "Bash(make mutation-all)",
      "Bash(make ci)",
      "Bash(make clean)",
      "Bash(make check-sec)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golines:*)",
      "Bash(golangci-lint:*)",
      "Bash(govulncheck:*)",
      "Bash(mutest -diff:*)",
      "Bash(pre-commit run:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/.envrc)",
      "Bash(go run:*)",
      "Bash(go generate:*)",
      "Bash(go test * -exec*)",
      "Bash(go test -exec*)",
      "Bash(go build * -toolexec*)",
      "Bash(go build -toolexec*)",
      "Bash(cd /*)",
      "Bash(cd ~*)",
      "Bash(cd ..)",
      "Bash(cd ../*)",
      "Bash(cd -*)",
      "Bash(cat *.env*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat *secrets*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * *.env*)",
      "Bash(sed * *.env*)",
      "Bash(awk * *.env*)",
      "Bash(find *secrets*)",
      "Bash(go install:*)",
      "Bash(go get:*)",
      "Bash(make run:*)",
      "Bash(make install-tools)"
    ]
  }
}
